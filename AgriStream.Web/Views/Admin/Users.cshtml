@model UsersViewModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Users";
    var me = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var emoji = new Dictionary<string, string> { ["Farmer"] = "🧑‍🌾", ["Agronomist"] = "🔬", ["Admin"] = "🛠️" };
}

<div class="page-header">
    <div>
        <h1>Users & Roles 👥</h1>
        <p>Accounts stored in the Azure SQL <code>Users</code> and <code>Roles</code> tables.</p>
    </div>
    <div class="d-flex gap-2">
        @foreach (var r in Model.Roles)
        {
            <span class="role-badge role-@r.Name fs-6">@emoji.GetValueOrDefault(r.Name) @Model.Users.Count(u => u.RoleId == r.Id) @r.Name</span>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card-fun top-grape"><div class="card-body">
            <h5 class="mb-3">➕ Add a user</h5>
            <form asp-action="CreateUser" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-2"></div>
                <div class="mb-3">
                    <label asp-for="NewUser.Username" class="form-label"></label>
                    <input asp-for="NewUser.Username" class="form-control" placeholder="username" />
                    <span asp-validation-for="NewUser.Username" class="field-validation-error"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NewUser.Password" class="form-label"></label>
                    <input asp-for="NewUser.Password" class="form-control" placeholder="At least 6 characters" />
                    <span asp-validation-for="NewUser.Password" class="field-validation-error"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NewUser.RoleId" class="form-label"></label>
                    <select asp-for="NewUser.RoleId" class="form-select" asp-items="@(new SelectList(Model.Roles, "Id", "Name"))"></select>
                </div>
                <button type="submit" class="btn btn-berry btn-pill w-100">Create user</button>
            </form>
        </div></div>
    </div>

    <div class="col-lg-8">
        <div class="card-fun">
            <div class="table-responsive">
                <table class="table table-fun">
                    <thead><tr><th>User</th><th>Role</th><th>Joined</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var u in Model.Users)
                        {
                            var isMe = u.Id.ToString() == me;
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="avatar">@u.Username[..1].ToUpperInvariant()</span>
                                        <div>
                                            <div class="fw-bold">@u.Username @if (isMe) { <span class="badge rounded-pill text-bg-warning">you</span> }</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <form asp-action="ChangeRole" method="post" class="d-flex gap-2 align-items-center">
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <select name="roleId" class="form-select form-select-sm" style="max-width:160px" onchange="this.form.submit()"
                                                asp-items="@(new SelectList(Model.Roles.Select(r => new { r.Id, Label = emoji.GetValueOrDefault(r.Name) + " " + r.Name }), "Id", "Label", u.RoleId))"></select>
                                    </form>
                                </td>
                                <td class="text-muted">@u.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td class="text-end">
                                    @if (!isMe)
                                    {
                                        <form asp-action="DeleteUser" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button type="submit" class="btn btn-sm btn-soft btn-pill text-danger" data-confirm="Delete @u.Username?"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
