@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var latest = Model.Snapshot.Latest;
    var devicesById = Model.Devices.ToDictionary(d => d.DeviceId, d => d);
}

<div class="page-header">
    <div>
        <h1>Field Dashboard 🌾</h1>
        <p>Hey @User.Identity?.Name, here's what your sensors reported in the last 24 hours.</p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="source-chip @(Model.FromFunction ? "" : "fallback")" title="Where this data came from">
            <span class="dot"></span> @Model.DataSource
        </span>
        <form asp-action="Simulate" method="post" class="d-inline">
            <button type="submit" class="btn btn-sun btn-pill" data-loading="Sending..."><i class="bi bi-broadcast"></i> Simulate sensor burst</button>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Warning))
{
    <div class="alert alert-warning border-0 rounded-4 fw-semibold"><i class="bi bi-info-circle"></i> @Model.Warning</div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-card grad-leaf">
            <div class="stat-label">Avg soil moisture</div>
            <div class="stat-value">@Model.AvgMoisture%</div>
            <i class="bi bi-moisture stat-icon"></i>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card grad-sun">
            <div class="stat-label">Avg air temp</div>
            <div class="stat-value">@Model.AvgAirTemperature°C</div>
            <i class="bi bi-thermometer-sun stat-icon"></i>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card grad-sky">
            <div class="stat-label">Avg humidity</div>
            <div class="stat-value">@Model.AvgHumidity%</div>
            <i class="bi bi-cloud-drizzle stat-icon"></i>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card grad-berry">
            <div class="stat-label">Sensors reporting</div>
            <div class="stat-value">@latest.Count <small class="fs-6">/ @Model.Devices.Count</small></div>
            <i class="bi bi-broadcast-pin stat-icon"></i>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="card-fun h-100"><div class="card-body">
            <h5 class="mb-3">💧 Moisture by sensor</h5>
            @if (latest.Count == 0)
            {
                <div class="empty-state"><span class="emoji">🌵</span>No readings yet. Hit <b>Simulate sensor burst</b>!</div>
            }
            else
            {
                <div style="position:relative;height:250px;width:100%">
                    <canvas id="moistureChart"></canvas>
                </div>
            }
        </div></div>
    </div>
    <div class="col-lg-7">
        <div class="card-fun h-100"><div class="card-body">
            <h5 class="mb-3">📈 Trends (30-min averages)</h5>
            @if (Model.TrendLabels.Count == 0)
            {
                <div class="empty-state"><span class="emoji">📭</span>Trends show up once readings arrive.</div>
            }
            else
            {
                <div style="position:relative;height:250px;width:100%">
                    <canvas id="trendChart"></canvas>
                </div>
            }
        </div></div>
    </div>
</div>

<div class="card-fun">
    <div class="card-body pb-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h5 class="mb-0">📡 Latest reading per sensor</h5>
        <form method="get" class="d-flex gap-2 align-items-center">
            <select name="deviceId" class="form-select form-select-sm" onchange="this.form.submit()"
                    asp-items="@(new SelectList(Model.Devices.Select(d => new { d.DeviceId, Label = d.DeviceId + " · " + d.Name }), "DeviceId", "Label", Model.SelectedDeviceId))">
                <option value="">All sensors</option>
            </select>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-fun">
            <thead>
                <tr>
                    <th>Sensor</th>
                    <th style="min-width:180px">Soil moisture</th>
                    <th>Soil °C</th>
                    <th>Air °C</th>
                    <th>Humidity</th>
                    <th>pH</th>
                    <th>Battery</th>
                    <th>When</th>
                </tr>
            </thead>
            <tbody>
                @if (latest.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No telemetry yet 🌱</td></tr>
                }
                @foreach (var r in latest)
                {
                    var mood = DisplayHelpers.MoistureMood(r.SoilMoisture);
                    devicesById.TryGetValue(r.DeviceId, out var dev);
                    <tr>
                        <td>
                            <div class="fw-bold">@r.DeviceId</div>
                            <div class="small text-muted">@(dev?.FieldName ?? "")</div>
                        </td>
                        <td>
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-bold">@r.SoilMoisture.ToString("0.0")%</span>
                                <span class="mood mood-@mood.Css">@mood.Emoji @mood.Label</span>
                            </div>
                            <div class="moisture-bar moisture-@mood.Css"><span style="width:@(Math.Clamp(r.SoilMoisture, 0, 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></span></div>
                        </td>
                        <td>@r.SoilTemperature.ToString("0.0")</td>
                        <td>@r.AirTemperature.ToString("0.0")</td>
                        <td>@r.Humidity.ToString("0")%</td>
                        <td>@r.Ph.ToString("0.0")</td>
                        <td>
                            <i class="bi @(r.BatteryLevel < 20 ? "bi-battery text-danger" : r.BatteryLevel < 60 ? "bi-battery-half text-warning" : "bi-battery-full text-success")"></i>
                            @r.BatteryLevel.ToString("0")%
                        </td>
                        <td class="text-muted">@r.RecordedAt.TimeAgo()</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const latest = @Json.Serialize(latest.Select(r => new { r.DeviceId, r.SoilMoisture }));
        const trendLabels = @Json.Serialize(Model.TrendLabels);
        const trendMoisture = @Json.Serialize(Model.TrendMoisture);
        const trendTemp = @Json.Serialize(Model.TrendTemperature);
        const trendHumidity = @Json.Serialize(Model.TrendHumidity);

        function drawBarChart(canvasId, items) {
            const canvas = document.getElementById(canvasId);
            if (!canvas || !items.length) return;
            const dpr = window.devicePixelRatio || 1;
            const rect = canvas.parentElement.getBoundingClientRect();
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;
            canvas.style.width = rect.width + 'px';
            canvas.style.height = rect.height + 'px';
            const ctx = canvas.getContext('2d');
            ctx.scale(dpr, dpr);

            const w = rect.width, h = rect.height;
            const padL = 38, padR = 14, padT = 18, padB = 34;
            const plotW = w - padL - padR, plotH = h - padT - padB;

            ctx.font = '12px Segoe UI, sans-serif';
            ctx.fillStyle = '#666';
            ctx.strokeStyle = '#e5e7eb';
            for (let v = 0; v <= 100; v += 25) {
                const y = padT + plotH - (v / 100) * plotH;
                ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(w - padR, y); ctx.stroke();
                ctx.fillText(v + '%', 4, y + 4);
            }

            const slot = plotW / items.length;
            const barW = Math.min(44, slot * 0.6);
            items.forEach((it, i) => {
                const val = Math.max(0, Math.min(100, it.soilMoisture));
                const bh = (val / 100) * plotH;
                const x = padL + i * slot + (slot - barW) / 2;
                const y = padT + plotH - bh;
                ctx.fillStyle = val < 25 ? '#e53935' : val > 65 ? '#1e88e5' : '#2e7d32';
                ctx.fillRect(x, y, barW, bh);
                ctx.fillStyle = '#222';
                ctx.font = 'bold 11px Segoe UI, sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText(val.toFixed(0) + '%', x + barW / 2, y - 5);
                ctx.fillStyle = '#555';
                ctx.font = '11px Segoe UI, sans-serif';
                ctx.fillText(it.deviceId.replace('SENSOR-', 'S-'), x + barW / 2, h - 10);
            });
        }

        function drawLineChart(canvasId, labels, s1, s2, s3) {
            const canvas = document.getElementById(canvasId);
            if (!canvas || !labels.length) return;
            const dpr = window.devicePixelRatio || 1;
            const rect = canvas.parentElement.getBoundingClientRect();
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;
            canvas.style.width = rect.width + 'px';
            canvas.style.height = rect.height + 'px';
            const ctx = canvas.getContext('2d');
            ctx.scale(dpr, dpr);

            const w = rect.width, h = rect.height;
            const padL = 36, padR = 16, padT = 26, padB = 34;
            const plotW = w - padL - padR, plotH = h - padT - padB;

            ctx.font = '12px Segoe UI, sans-serif';
            ctx.fillStyle = '#666';
            ctx.strokeStyle = '#e5e7eb';
            for (let v = 0; v <= 100; v += 25) {
                const y = padT + plotH - (v / 100) * plotH;
                ctx.beginPath(); ctx.moveTo(padL, y); ctx.lineTo(w - padR, y); ctx.stroke();
                ctx.fillText(v, 6, y + 4);
            }

            const series = [
                { name: 'Moisture %', data: s1, color: '#2e7d32' },
                { name: 'Air °C', data: s2, color: '#f57f17' },
                { name: 'Humidity %', data: s3, color: '#0288d1' }
            ];

            // Legend
            let lx = padL;
            series.forEach(sr => {
                ctx.fillStyle = sr.color;
                ctx.fillRect(lx, 6, 12, 12);
                ctx.fillStyle = '#333';
                ctx.font = 'bold 12px Segoe UI, sans-serif';
                ctx.fillText(sr.name, lx + 16, 16);
                lx += ctx.measureText(sr.name).width + 36;
            });

            const stepX = labels.length > 1 ? plotW / (labels.length - 1) : plotW;
            series.forEach(sr => {
                ctx.strokeStyle = sr.color;
                ctx.lineWidth = 2.5;
                ctx.beginPath();
                sr.data.forEach((v, i) => {
                    const x = padL + (labels.length > 1 ? i * stepX : plotW / 2);
                    const y = padT + plotH - (Math.max(0, Math.min(100, v)) / 100) * plotH;
                    if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
                });
                ctx.stroke();
                sr.data.forEach((v, i) => {
                    const x = padL + (labels.length > 1 ? i * stepX : plotW / 2);
                    const y = padT + plotH - (Math.max(0, Math.min(100, v)) / 100) * plotH;
                    ctx.fillStyle = sr.color;
                    ctx.beginPath(); ctx.arc(x, y, 3.5, 0, Math.PI * 2); ctx.fill();
                });
            });

            ctx.fillStyle = '#555';
            ctx.font = '11px Segoe UI, sans-serif';
            ctx.textAlign = 'center';
            const stride = Math.max(1, Math.ceil(labels.length / 8));
            labels.forEach((lb, i) => {
                if (i % stride === 0 || i === labels.length - 1) {
                    const x = padL + (labels.length > 1 ? i * stepX : plotW / 2);
                    ctx.fillText(lb, x, h - 10);
                }
            });
        }

        drawBarChart('moistureChart', latest);
        drawLineChart('trendChart', trendLabels, trendMoisture, trendTemp, trendHumidity);
        window.addEventListener('resize', () => {
            drawBarChart('moistureChart', latest);
            drawLineChart('trendChart', trendLabels, trendMoisture, trendTemp, trendHumidity);
        });
    </script>
}
