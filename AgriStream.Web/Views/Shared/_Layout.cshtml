@using System.Security.Claims
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string c) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var isAuth = User.Identity?.IsAuthenticated == true;
    var role = User.FindFirstValue(ClaimTypes.Role) ?? "";
    var userName = User.Identity?.Name ?? "";
    var instanceId = Environment.GetEnvironmentVariable("WEBSITE_INSTANCE_ID");
    var instance = string.IsNullOrEmpty(instanceId) ? Environment.MachineName : instanceId[..Math.Min(8, instanceId.Length)];
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AgriStream IoT</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-agri">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="bi bi-flower1 me-1"></i> AgriStream IoT
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto gap-1">
                    <li class="nav-item">
                        <a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    @if (isAuth)
                    {
                        <li class="nav-item">
                            <a class="nav-link @Active("Dashboard")" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Active("Devices")" asp-controller="Devices" asp-action="Index">Sensors & Irrigation</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Active("Drone")" asp-controller="Drone" asp-action="Index">Drone Images</a>
                        </li>
                        @if (role == AppRoles.Agronomist || role == AppRoles.Admin)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("Audit")" asp-controller="Audit" asp-action="Index">Audit Logs</a>
                            </li>
                        }
                        @if (role == AppRoles.Admin)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("Admin")" asp-controller="Admin" asp-action="Users">Manage Users</a>
                            </li>
                        }
                    }
                </ul>

                <div class="d-flex align-items-center gap-2 mt-2 mt-lg-0">
                    @if (isAuth)
                    {
                        <span class="text-white small me-1">
                            Logged in as <strong>@userName</strong>
                            <span class="role-badge role-@role ms-1">@role</span>
                        </span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-warning fw-semibold">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">Login</a>
                        <a class="btn btn-sm btn-warning fw-semibold" asp-controller="Account" asp-action="Register">Register</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main class="container py-4 flex-grow-1">
        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @ok
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @err
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="footer-agri">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
            <span>AgriStream IoT Farm Management System - CLDV7112 Practicum (@DateTime.UtcNow.Year)</span>
            <span class="badge bg-secondary">Server Instance: @instance</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
